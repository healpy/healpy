project('cfitsio', 'c')
inc = include_directories('.')
meson.override_dependency(
    'cfitsio',
    declare_dependency(
        link_with: shared_library(
            'cfitsio',
            'buffers.c',
            'cfileio.c',
            'checksum.c',
            'drvrfile.c',
            'drvrmem.c',
            'drvrnet.c',
            'drvrsmem.c',
            'editcol.c',
            'edithdu.c',
            'eval_l.c',
            'eval_y.c',
            'eval_f.c',
            'fitscore.c',
            'getcol.c',
            'getcolb.c',
            'getcold.c',
            'getcole.c',
            'getcoli.c',
            'getcolj.c',
            'getcolk.c',
            'getcoll.c',
            'getcols.c',
            'getcolsb.c',
            'getcoluk.c',
            'getcolui.c',
            'getcoluj.c',
            'getkey.c',
            'group.c',
            'grparser.c',
            'histo.c',
            'iraffits.c',
            'modkey.c',
            'putcol.c',
            'putcolb.c',
            'putcold.c',
            'putcole.c',
            'putcoli.c',
            'putcolj.c',
            'putcolk.c',
            'putcoluk.c',
            'putcoll.c',
            'putcols.c',
            'putcolsb.c',
            'putcolu.c',
            'putcolui.c',
            'putcoluj.c',
            'putkey.c',
            'region.c',
            'scalnull.c',
            'wcssub.c',
            'wcsutil.c',
            'imcompress.c',
            'quantize.c',
            'ricecomp.c',
            'pliocomp.c',
            'fits_hcompress.c',
            'fits_hdecompress.c',
            'simplerng.c',
            'zcompress.c',
            'zuncompress.c',
            'swapproc.c',
            c_args: [
                '-D_LARGEFILE_SOURCE=1',
                '-D_FILE_OFFSET_BITS=64',
                '-DHAVE_FTRUNCATE=1',
                '-DHAVE_LONGLONG=1',
                '-Wno-implicit-function-declaration',
            ],
            dependencies: [
                meson.get_compiler('c').find_library('m'),
                dependency('zlib'),
            ],
            install: true,
        ),
        include_directories: inc,
    ),
)
